# ============================================================
# .gitignore — Projet Bibliotheque (backend + frontend + database)
# A placer a la RACINE du depot (a cote de database/, backend/, frontend/)
# ============================================================

# ---------- Backend Node.js ----------
node_modules/           # dependances installees par npm, jamais versionnees (trop volumineux)
npm-debug.log*
yarn-debug.log*
yarn-error.log*
package-lock.json.bak

# ---------- Variables d'environnement (secrets) ----------
.env                    # contient les vrais identifiants PostgreSQL, ne doit JAMAIS partir sur GitHub
.env.local
.env.*.local
# .env.example reste versionne volontairement (pas de secret dedans)

# ---------- Logs ----------
*.log
logs/

# ---------- PostgreSQL / donnees locales ----------
*.sql.bak
dump.sql
pgdata/                 # si jamais un tablespace ou une sauvegarde locale traine dans le projet

# ---------- Editeurs / IDE ----------
.vscode/
.idea/
*.swp
*.swo

# ---------- Android / Termux / Acode (fichiers parasites) ----------
.thumbnails/
.Trash-1000/
.nomedia
.acode/
*.crdownload

# ---------- Systeme ----------
.DS_Store               # macOS
Thumbs.db                # Windows
desktop.ini               # Windows

# ---------- Divers ----------
*.tmp
*.bak
coverage/                 # rapports de tests si tu en ajoutes plus tard
